# Local development defaults to data/accounts.sqlite (Node 24).
# Online production MUST use an independent, backed-up PostgreSQL database.
# Never commit your real .env or database credentials.
NODE_ENV=development
PORT=3000

# Production settings (set in Render Environment, not in Git):
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# PUBLIC_ORIGIN=https://YOUR-SERVICE.onrender.com

# Optional local SQLite path; never used as a production fallback:
# SQLITE_PATH=data/accounts.sqlite
