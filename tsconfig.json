{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "Node16",
    "target": "ES2022",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "public/modules/**/*.js",
    "auth-store.js"
  ]
}
